# Configuração do painel de câmeras. Instalado em /etc/painel-cameras.env
# com modo 600 (só o root lê), porque contém as senhas das câmeras.
#
# Formato: CHAVE=valor, uma por linha, sem aspas. Linhas com # são comentários.
# A senha é lida literalmente: $, ", \ e espaços não precisam de escape.

# --- Câmera 1 ----------------------------------------------------------------
CAM1_NOME=Garagem
CAM1_HOST=192.168.1.50
CAM1_USER=admin
CAM1_PASS=troque-esta-senha
# Opcionais (valores padrão mostrados):
#CAM1_PORTA=554
#CAM1_CAMINHO=/onvif1
# udp ou tcp. Algumas câmeras só funcionam com um dos dois (ver README).
#CAM1_TRANSPORTE=udp

# --- Câmera 2 (descomente para usar; o painel faz rodízio entre as câmeras) ---
#CAM2_NOME=Quintal
#CAM2_HOST=192.168.1.51
#CAM2_USER=admin
#CAM2_PASS=troque-esta-senha

# --- Opções gerais (valores padrão mostrados) --------------------------------
# Segundos que cada câmera fica na tela:
#PAINEL_ROTACAO=10
# Segundos de pausa entre capturas:
#PAINEL_PAUSA=2
# Gravar as fotos em disco (1 = sim, 0 = não):
#PAINEL_GRAVAR=1
#PAINEL_GRAVAR_DIR=/var/lib/painel
# Apagar fotos com mais de N dias:
#PAINEL_RETENCAO_DIAS=7
# Limite de espaço das fotos; ao passar, apaga as mais antigas primeiro:
#PAINEL_LIMITE_GB=8
